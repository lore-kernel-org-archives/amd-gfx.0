-				return;
-
-			/* Turn the connector off and back on immediately, which
-			 * will trigger link training
-			 */
-			drm_helper_connector_dpms(connector, DRM_MODE_DPMS_OFF);
-			drm_helper_connector_dpms(connector, DRM_MODE_DPMS_ON);
