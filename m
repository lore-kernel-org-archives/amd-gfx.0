Subject: [PATCH] drm/amdgpu: Fix comments error in sdma_v4_1_update_power_g=
ating

Signed-off-by: Rex Zhu <Rex.Zhu-5C7GfCeVMHo@public.gmane.org>
---
 drivers/gpu/drm/amd/amdgpu/sdma_v4_0.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/sdma_v4_0.c b/drivers/gpu/drm/amd/a=
mdgpu/sdma_v4_0.c
index a3e2ed1..12e577c 100644
--- a/drivers/gpu/drm/amd/amdgpu/sdma_v4_0.c
+++ b/drivers/gpu/drm/amd/amdgpu/sdma_v4_0.c
@@ -818,7 +818,7 @@ static int sdma_v4_0_gfx_resume(struct amdgpu_device *a=
dev)
         uint32_t def, data;

         if (enable && (adev->pg_flags & AMD_PG_SUPPORT_SDMA)) {
-               /* disable idle interrupt */
+               /* enable idle interrupt */
                 def =3D data =3D RREG32(SOC15_REG_OFFSET(SDMA0, 0, mmSDMA0=
_CNTL));
                 data |=3D SDMA0_CNTL__CTXEMPTY_INT_ENABLE_MASK;

--
