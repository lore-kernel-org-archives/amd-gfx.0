 		DMI_MATCH(DMI_SYS_VENDOR, "GIGABYTE"),
 		DMI_MATCH(DMI_PRODUCT_NAME, "GB-BXBT-2807"),
 		},
@@ -231,17 +231,17 @@ static const struct dmi_system_id video_detect_dmi_table[] = {
