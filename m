-<br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; return 0;<br>
&nbsp;}<br>
&nbsp;<br>
@@ -1149,6 &#43;1146,9 @@ static int vi_common_hw_fini(void *handle)<br>
