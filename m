Subject: [PATCH] drm/amd/pp: reset dpm level when adjust power state

Change-Id: I312d1cf7b964d25d698b02800ce7cd06ac33b28f
Signed-off-by: Rex Zhu <Rex.Zhu-5C7GfCeVMHo@public.gmane.org>
---
 drivers/gpu/drm/amd/powerplay/hwmgr/pp_psm.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/amd/powerplay/hwmgr/pp_psm.c b/drivers/gpu/drm=
/amd/powerplay/hwmgr/pp_psm.c
index ffa44bb..ab852b2 100644
--- a/drivers/gpu/drm/amd/powerplay/hwmgr/pp_psm.c
+++ b/drivers/gpu/drm/amd/powerplay/hwmgr/pp_psm.c
@@ -244,7 +244,7 @@ int psm_adjust_power_state_dynamic(struct pp_hwmgr *hwm=
gr, bool skip,
         }

         phm_notify_smc_display_config_after_ps_adjustment(hwmgr);
-
+       phm_force_dpm_levels(hwmgr, hwmgr->dpm_level);
         return 0;
 }

